generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Singleton row (id "default") holding the Garmin OAuth tokens so sync
// doesn't have to log in with credentials on every run.
model GarminAuth {
  id        String   @id @default("default")
  oauth1    Json
  oauth2    Json
  updatedAt DateTime @updatedAt
}

model Activity {
  id          String   @id @default(cuid())
  garminId    String   @unique
  type        String
  name        String?
  startTime   DateTime
  durationSec Int
  distanceM   Float?
  avgHr       Int?
  maxHr       Int?
  calories    Int?
  raw         Json?
  createdAt   DateTime @default(now())

  session Session?
}

model Session {
  id             String    @id @default(cuid())
  date           DateTime
  type           String
  title          String
  description    String?
  targetDuration Int?
  targetDistance Float?
  completed      Boolean   @default(false)
  activity       Activity? @relation(fields: [activityId], references: [id])
  activityId     String?   @unique
  createdAt      DateTime  @default(now())
}
