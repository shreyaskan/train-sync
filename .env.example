# Postgres connection used by Prisma
DATABASE_URL="postgresql://trainsync:trainsync@localhost:5433/trainsync"

# Garmin Connect credentials (unofficial API — your normal login)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# API server
PORT=3001

# Cron expression for how often activities sync (default: hourly)
SYNC_CRON="0 * * * *"
